{
  "name": "examforge",
  "description": "ExamForge - Government Exam Question Bank & Practice Platform",
  "keywords": [
    "ExamForge",
    "Government Exams",
    "Question Bank",
    "MCQ",
    "Practice Platform",
    "Next.js",
    "MySQL"
  ],
  "workspaces": [
    "studio",
    "frontend"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:next": "npm run dev --workspace=frontend",
    "dev:studio": "npm run dev --workspace=studio",
    "format": "prettier --cache --write .",
    "lint": "npm run lint --workspace=frontend",
    "type-check": "npm run type-check --workspaces"
  },
  "packageManager": "npm@11.6.2",
  "prettier": "@sanity/prettier-config",
  "devDependencies": {
    "@next/swc-wasm-nodejs": "^16.4.5",
    "@sanity/prettier-config": "^3.0.0",
    "npm-run-all2": "^5.0.2",
    "prettier": "^3.8.3",
    "turbo": "^2.10.2"
  }
}
